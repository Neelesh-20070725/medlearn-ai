DATABASE_URL=postgresql://user:password@localhost:5432/medlearn
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
API_VERSION=v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# AI Provider Keys (at least one required for live AI generation;
# app works without keys using structured educational fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Security
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Model selection (overridable per-deployment)
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-flash
